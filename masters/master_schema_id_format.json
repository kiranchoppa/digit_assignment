{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DIGIT-ASSIGNMENT.IdFormat",
  "type": "object",
  "properties": {
    "idName": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "required": [
    "idName",
    "format",
    "isActive"
  ],
  "x-unique": [
    "idName"
  ]
}
