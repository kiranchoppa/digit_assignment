{
  "info": {
    "name": "DIGIT Assignment - Advocate Clerk APIs",
    "description": "Postman tests for advocate clerk create, update, and search endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/digit_assignment" },
    { "key": "tenantId", "value": "pg" },
    { "key": "authToken", "value": "local-token" },
    { "key": "userUuid", "value": "c1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d" },
    { "key": "applicationNumber", "value": "" },
    { "key": "clerkId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Clerk",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('applicationNumber', json.clerks[0].applicationNumber);",
              "pm.collectionVariables.set('clerkId', json.clerks[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/clerk/v1/_create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RequestInfo\": {\n    \"apiId\": \"Rainmaker\",\n    \"ver\": \"1.0\",\n    \"ts\": 1718200000000,\n    \"action\": \"_create\",\n    \"msgId\": \"1|en_IN\",\n    \"authToken\": \"{{authToken}}\",\n    \"userInfo\": { \"id\": 1, \"uuid\": \"{{userUuid}}\", \"userName\": \"clerk-user\", \"type\": \"CITIZEN\", \"tenantId\": \"{{tenantId}}\", \"roles\": [{ \"code\": \"ADVOCATE_CLERK\", \"tenantId\": \"{{tenantId}}\" }] }\n  },\n  \"clerk\": {\n    \"tenantId\": \"{{tenantId}}\",\n    \"stateRegnNumber\": \"KL/2024/54321\",\n    \"individualId\": \"IND-PG-2024-000456\",\n    \"isActive\": true,\n    \"workflow\": { \"action\": \"APPLY\" },\n    \"documents\": [{ \"documentType\": \"STATE_REGISTRATION\", \"fileStore\": \"filestore-uuid-2\", \"documentUid\": \"KL54321\" }],\n    \"additionalDetails\": { \"userType\": \"ADVOCATE_CLERK\" }\n  }\n}"
        }
      }
    },
    {
      "name": "Update Clerk",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/clerk/v1/_update",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RequestInfo\": { \"apiId\": \"Rainmaker\", \"ver\": \"1.0\", \"ts\": 1718200000000, \"action\": \"_update\", \"msgId\": \"2|en_IN\", \"authToken\": \"{{authToken}}\", \"userInfo\": { \"id\": 2, \"uuid\": \"b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e\", \"userName\": \"nyaymitra\", \"type\": \"EMPLOYEE\", \"tenantId\": \"{{tenantId}}\", \"roles\": [{ \"code\": \"NYAY_MITRA\", \"tenantId\": \"{{tenantId}}\" }] } },\n  \"clerk\": {\n    \"id\": \"{{clerkId}}\",\n    \"tenantId\": \"{{tenantId}}\",\n    \"applicationNumber\": \"{{applicationNumber}}\",\n    \"stateRegnNumber\": \"KL/2024/54321\",\n    \"individualId\": \"IND-PG-2024-000456\",\n    \"workflow\": { \"action\": \"APPROVE\", \"comment\": \"Verified\" }\n  }\n}"
        }
      }
    },
    {
      "name": "Search Clerk",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/clerk/v1/_search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"RequestInfo\": { \"apiId\": \"Rainmaker\", \"ver\": \"1.0\", \"ts\": 1718200000000, \"action\": \"_search\", \"msgId\": \"3|en_IN\", \"authToken\": \"{{authToken}}\" },\n  \"tenantId\": \"{{tenantId}}\",\n  \"criteria\": [{ \"applicationNumber\": \"{{applicationNumber}}\" }]\n}"
        }
      }
    },
    {
      "name": "Search Clerk By Application Number",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/clerk/v1/applicationnumber/_search?tenantId={{tenantId}}&applicationNumber={{applicationNumber}}"
      }
    },
    {
      "name": "Search Clerk By Status",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/clerk/v1/status/_search?tenantId={{tenantId}}&status=ACTIVE"
      }
    }
  ]
}
